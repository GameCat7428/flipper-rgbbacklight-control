+            uint8_t prev =
+                lp5562_get_channel_value(&furi_hal_i2c_handle_power, LP5562ChannelWhite);
+            lp5562_execute_ramp(
+                &furi_hal_i2c_handle_power, LP5562Engine1, LP5562ChannelWhite, prev, value, 100);
+        }
     }
     furi_hal_i2c_release(&furi_hal_i2c_handle_power);
