--- a/targets/f7/furi_hal/furi_hal_light.c
+++ b/targets/f7/furi_hal/furi_hal_light.c
@@ -2,6 +2,7 @@
 #include <furi_hal_resources.h>
 #include <furi_hal_light.h>
 #include <lp5562.h>
+#include <rgb_backlight.h>
 #include <stdint.h>
 
 #define LED_CURRENT_RED   (50u)
@@ -42,9 +43,19 @@ void furi_hal_light_set(Light light, uint8_t value) {
         lp5562_set_channel_value(&furi_hal_i2c_handle_power, LP5562ChannelBlue, value);
     }
     if(light & LightBacklight) {
-        uint8_t prev = lp5562_get_channel_value(&furi_hal_i2c_handle_power, LP5562ChannelWhite);
-        lp5562_execute_ramp(
-            &furi_hal_i2c_handle_power, LP5562Engine1, LP5562ChannelWhite, prev, value, 100);
+        rgb_backlight_update(value, false);
+
+        if(rgb_backlight_is_enabled()) {
+            lp5562_stop_program(&furi_hal_i2c_handle_power, LP5562Engine1);
+            lp5562_set_channel_src(
+                &furi_hal_i2c_handle_power, LP5562ChannelWhite, LP5562Direct);
